<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <%- include('partials/navbar') %>

        <main class="container fade-in-up">
            <div class="section-header">
                <div class="mono-badge">
                    <span class="dot"></span>
                    <span>Portafolio & Experiencia</span>
                </div>
                <h1>Proyectos Destacados</h1>
                <p>Una muestra de desarrollos de software modernos y proyectos de infraestructura crítica IT.</p>
            </div>

            <!-- Sección Desarrollo -->
            <h2 style="margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-laptop-code" style="color: var(--color-acid-lime); font-size: 1.2rem;"></i>
                <span>Desarrollo de Software</span>
            </h2>

            <div class="project-grid" style="margin-bottom: 64px;">
                <% projects.development.forEach(project=> { %>
                    <article class="project-card">
                        <div class="project-image-wrapper">
                            <img src="<%= project.image %>" alt="<%= project.title %>" class="project-image"
                                loading="lazy">
                            <% if (project.type) { %>
                                <span class="project-type-badge">
                                    <%= project.type %>
                                </span>
                                <% } %>
                        </div>
                        <div class="project-info">
                            <h3>
                                <%= project.title %>
                            </h3>
                            <p>
                                <%= project.description %>
                            </p>
                            <div class="project-tags">
                                <% project.tags.forEach(tag=> { %>
                                    <span class="tag">
                                        <%= tag %>
                                    </span>
                                    <% }) %>
                            </div>
                            <% if (project.link && project.link !=='#' ) { %>
                                <a href="<%= project.link %>" target="_blank" rel="noopener noreferrer"
                                    class="btn-project">
                                    <span>Ver Demo / Sitio Web</span>
                                    <i class="fas fa-external-link-alt" style="font-size: 0.8rem;"></i>
                                </a>
                                <% } %>
                        </div>
                    </article>
                    <% }) %>
            </div>

            <div class="section-divider"></div>

            <!-- Sección Soporte -->
            <h2 style="margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-server" style="color: var(--color-signal-teal); font-size: 1.2rem;"></i>
                <span>Soporte Técnico & Infraestructura IT</span>
            </h2>

            <div class="project-grid">
                <% projects.support.forEach(project=> { %>
                    <article class="project-card">
                        <div class="project-image-wrapper">
                            <img src="<%= project.image %>" alt="<%= project.title %>" class="project-image"
                                loading="lazy">
                        </div>
                        <div class="project-info">
                            <h3>
                                <%= project.title %>
                            </h3>
                            <div class="project-role">
                                <%= project.role %>
                            </div>
                            <p>
                                <%= project.description %>
                            </p>
                            <div class="project-tags">
                                <% project.tags.forEach(tag=> { %>
                                    <span class="tag">
                                        <%= tag %>
                                    </span>
                                    <% }) %>
                            </div>
                        </div>
                    </article>
                    <% }) %>
            </div>
        </main>

        <%- include('partials/footer') %>
</body>

</html>